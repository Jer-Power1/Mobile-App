<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Movie"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fill in the details below"
            android:textColor="#A6A6BC"
            android:textSize="15sp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOVIE TITLE"
            android:textColor="#A996FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/movie_input_background"
            android:hint="Enter movie title"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8FA9"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:padding="16dp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textColor="#A996FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/movie_input_background"
            android:hint="What's this movie about?"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8FA9"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:padding="16dp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RELEASE DATE"
            android:textColor="#A996FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />


        <Button
            android:id="@+id/datePickerButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SELECT RELEASE DATE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#292A45"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/selectedDateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No release date selected"
            android:textColor="#A6A6BC"
            android:textSize="14sp"
            android:layout_marginBottom="28dp" />


        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE MOVIE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#7856FF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#292A45" />

    </LinearLayout>

</ScrollView>
